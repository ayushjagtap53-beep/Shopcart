# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB instance or Atlas connection string)
# Note: If no local MongoDB is running, backend automatically boots MongoDB In-Memory Server fallback
MONGO_URI=mongodb://127.0.0.1:27017/shopkart

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client URL (for CORS credentials)
CLIENT_URL=http://localhost:5173

# Optional: Razorpay Test / Live Keys
# If omitted or left as defaults, the app seamlessly runs with the built-in interactive Razorpay portal
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret
